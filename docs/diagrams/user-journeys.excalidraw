      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false,
      "text": "exclude — noise, misfires, the vendor's own\ndemo files. Dropped from charts and search too.",
      "fontSize": 13, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "exclude — noise, misfires, the vendor's own\ndemo files. Dropped from charts and search too.",
      "lineHeight": 1.25
    },
    {
      "id": "jAnote", "type": "text", "x": 1470, "y": 440, "width": 430, "height": 140,
      "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100,
      "groupIds": [], "frameId": null, "roundness": null, "seed": 1032, "version": 1, "versionNonce": 1032,
      "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false,
      "text": "The tier is enforced by what exists on disk,\nnot by a flag downstream tools must respect.\n\nSeparately, you may tick mark for cloud deletion.\nThat only makes a recording ELIGIBLE. No\nscheduled job ever deletes anything — pruning\nis a command you type, on purpose, later.",
      "fontSize": 13, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "The tier is enforced by what exists on disk,\nnot by a flag downstream tools must respect.\n\nSeparately, you may tick mark for cloud deletion.\nThat only makes a recording ELIGIBLE. No\nscheduled job ever deletes anything — pruning\nis a command you type, on purpose, later.",
      "lineHeight": 1.25
    },

