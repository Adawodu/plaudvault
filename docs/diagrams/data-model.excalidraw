   "versionNonce": 68420,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PRECIOUS vs DERIVED",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "PRECIOUS vs DERIVED",
   "lineHeight": 1.25
  },
  {
   "id": "keep_b",
   "type": "text",
   "x": 80,
   "y": 712,
   "width": 500,
   "height": 240,
   "angle": 0,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 69696,
   "version": 1,
   "versionNonce": 69696,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PRECIOUS \u2014 cannot be recomputed\n   the audio files on disk\n   verification facts (sha256, size_ok, audio_kind)\n   triage decisions\n   accept / reject, intent, outcome scores\n   the action_events journal\n\nDERIVED \u2014 delete and re-run at will\n   transcripts, summaries, sentiment\n   chunks + vectors, notes, stack/ copies\n   proposed (not yet decided) actions\n\nThe split matters: a backup that captures only the\nfirst group loses nothing that cannot be rebuilt.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "PRECIOUS \u2014 cannot be recomputed\n   the audio files on disk\n   verification facts (sha256, size_ok, audio_kind)\n   triage decisions\n   accept / reject, intent, outcome scores\n   the action_events journal\n\nDERIVED \u2014 delete and re-run at will\n   transcripts, summaries, sentiment\n   chunks + vectors, notes, stack/ copies\n   proposed (not yet decided) actions\n\nThe split matters: a backup that captures only the\nfirst group loses nothing that cannot be rebuilt.",
   "lineHeight": 1.25
  },
