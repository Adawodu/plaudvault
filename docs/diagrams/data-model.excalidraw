   "link": null,
   "locked": false,
   "text": "CONCURRENCY\nWAL mode + a 30s busy timeout, so the\nconsole reads while a run writes.\n\nplaudctl run also takes a file lock: two\nprocesses writing this manifest produced\nreal corruption in testing.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "CONCURRENCY\nWAL mode + a 30s busy timeout, so the\nconsole reads while a run writes.\n\nplaudctl run also takes a file lock: two\nprocesses writing this manifest produced\nreal corruption in testing.",
   "lineHeight": 1.25
  }
